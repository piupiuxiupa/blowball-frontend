# CRUD/API service (auth, session CRUD, message history, workspace files) — server.port
VITE_API_BASE_URL=http://localhost:8080

# Agent/streaming service (POST /sessions/:id/messages, /mcp/tools) — server.agent_port.
# Defaults to VITE_API_BASE_URL when unset, so the monolith (--role all) and dev
# keep working unchanged. Set this only for the split deployment.
VITE_AGENT_BASE_URL=http://localhost:8081

# office-vers: 版本化文件存储服务（MinIO 原生版本控制）。前端直连（MVP 无鉴权），
# 以登录用户 id 作 {uuid} 命名空间。须对该源开启 CORS。
VITE_OFFICE_VERS_BASE_URL=http://localhost:8080

# Force-upgrade every insecure (http://) subresource request to https:// on the
# page, via a `upgrade-insecure-requests` Content Security Policy injected at app
# bootstrap (see src/main.tsx; openspec change force-https-csp). Page-global:
# applies to every insecure subresource the app requests.
# PRODUCTION-ONLY — default OFF (leave unset/commented). WARNING: do NOT enable
# locally; it rewrites http://localhost:* to https://localhost:* (no TLS listener)
# and breaks all local requests. Enable only where all target origins are
# actually HTTPS-reachable.
# VITE_UPGRADE_INSECURE_REQUESTS=true

VITE_BASE_PATH=/
